{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "1 day",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "nix": { "enabled": true },
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    {
      "description": "Mises à jour mineures et correctifs npm groupés",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dépendances npm (mineures)"
    },
    {
      "description": "Mises à jour mineures et correctifs Cargo groupés",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dépendances Cargo (mineures)"
    },
    {
      "description": "Actions GitHub groupées",
      "matchManagers": ["github-actions"],
      "groupName": "actions GitHub"
    },
    {
      "description": "svelte-check 4 ne prend pas encore en charge TypeScript 7",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
